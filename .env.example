# Copy this file to `.env` (same folder) and fill in your own values.
#
#   cp .env.example .env
#
# `doctor` reads it and tells you what it found. Anything you have already set
# in your terminal with `export` WINS over this file, so if a key here seems to
# be ignored, check whether the same name is exported in that terminal.
#
# Pick ONE messaging rail. You do not need both.

# --- SendBlue: a normal text thread on your own phone number ---------------
# npm i -g @sendblue/cli && sendblue setup --phone +1XXXXXXXXXX
SENDBLUE_API_API_KEY=
SENDBLUE_API_API_SECRET=
SENDBLUE_FROM_NUMBER=+1
SENDBLUE_TO_NUMBER=+1

# --- Telegram: tappable buttons --------------------------------------------
# Talk to @BotFather, then /newbot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Leave this alone until you have watched the whole loop work ------------
# Setting it to 1 lets applications reach REAL employers.
# OPENRECRUITER_ALLOW_REAL_SUBMIT=0
